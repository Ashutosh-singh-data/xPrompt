# ConsultOS Backend Configuration
APP_NAME=ConsultOS Backend
API_PREFIX=/api
DEBUG=true

# Database Configuration (SQLite default with predictable absolute path if omitted)
# Example: sqlite:///d:/ConsultOS/backend/consultos.db
DATABASE_URL=sqlite:///./consultos.db

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
